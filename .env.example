# Wedora Environment Variables
# Copy this file to .env and fill in your values

# Demo Mode — set to true for client demonstrations without Supabase
VITE_DEMO_MODE=false

# Public Site URL — the canonical URL of your published site
# Used for share links, Open Graph tags, and canonical URLs
VITE_PUBLIC_SITE_URL=https://wedora.uk

# Supabase Configuration
VITE_PUBLIC_SUPABASE_URL=your_supabase_url
VITE_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Maps (optional)
VITE_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key