# Vowora environment variables
#
# Copy to .env for local development. Everything prefixed VITE_ is compiled into
# the public browser bundle, so ONLY publishable values belong here. Readdy's
# GitHub sync commits a root .env with the Supabase URL and anon key; that is
# expected, and `node scripts/check-repository.mjs` fails the build if it ever
# holds anything other than VITE_PUBLIC_ values.

# ── Browser (public, bundled) ────────────────────────────────────────────────

# Demo mode: true for client demonstrations without Supabase
VITE_DEMO_MODE=false

# Canonical URL of the published site (share links, Open Graph, canonical tags)
VITE_PUBLIC_SITE_URL=https://vowora.uk

# Supabase project URL and publishable/anon key (protected by RLS, safe to expose)
VITE_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Stripe publishable key (pk_live_… / pk_test_…). Never put sk_ keys here.
VITE_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Google Maps embed key. Restrict it in Google Cloud to HTTP referrers
# https://vowora.uk/* and https://www.vowora.uk/* and to the Maps Embed API only.
VITE_PUBLIC_GOOGLE_MAPS_KEY=your_referrer_restricted_maps_key

# Release version, set before each production deployment (e.g. 2026.11.22.1)
VITE_RELEASE_VERSION=dev

# ── Server secrets (Supabase Edge Function secrets — NEVER in .env or VITE_) ──
# Set these in Supabase → Project Settings → Edge Functions → Secrets, or with
# `supabase secrets set NAME=value`. They are listed here for reference only.
#
# SUPABASE_SERVICE_ROLE_KEY          (provided automatically by Supabase)
# STRIPE_SECRET_KEY                  sk_live_… / sk_test_…
# STRIPE_WEBHOOK_SECRET              whsec_… for stripe-webhook-handler
# STRIPE_GIFT_FUND_WEBHOOK_SECRET    whsec_… for stripe-gift-fund-webhook (platform events)
# STRIPE_GIFT_FUND_CONNECT_WEBHOOK_SECRET  whsec_… (connected-account events)
# RESEND_API_KEY                     re_…
# RESEND_FROM_DOMAIN                 verified sending domain
# RESEND_WEBHOOK_SECRET              svix signing secret for email-webhook
# EMAIL_PREFERENCE_SECRET            random 32+ byte value (unsubscribe links)
# INVITATION_LINK_SECRET             random 32+ byte value (member invitations)
# GALLERY_SCAN_WORKER_SECRET         random 32+ byte value (gallery-scan-worker)
# GOOGLE_PLACES_API_KEY              server key, restricted to the Places API
# PUBLIC_SITE_URL                    https://vowora.uk
# ALLOWED_ORIGINS                    extra trusted browser origins, comma-separated
#                                    (e.g. a staging or Readdy preview origin)
# ENVIRONMENT                        production | development | local
